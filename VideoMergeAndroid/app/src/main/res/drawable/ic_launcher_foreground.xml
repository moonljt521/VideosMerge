    <path android:pathData="M36.72,46.44 m4.32,0 a4.32,4.32 0 1,1 -8.64,0 a4.32,4.32 0 1,1 8.64,0"
        android:strokeColor="#FF26C6DA" android:strokeWidth="3.6" android:fillColor="#00000000"/>
