# VideoMerger iOS - CocoaPods 依赖配置
#
# FFmpegKit 在 2025 年初被官方归档。这里使用社区维护的方案：
#
# 方案 A（推荐）：xpcapital 预编译 xcframework + podspec
#   - 直接从 GitHub raw 加载 podspec，不依赖 cocoapods master spec repo
#   - 包含完整的 ffmpeg + ffmpegkit 二进制（iOS full-gpl，约 100MB）
#   - 与 Android 端 full-gpl 变体对齐
#
# 方案 B：arthenica/ffmpeg-kit-next（需要本地构建 xcframework）
#   - https://github.com/arthenica/ffmpeg-kit-next
#   - 需按其 wiki 自己 build apple xcframeworks，然后 SPM 集成
#   - 适合需要自定义编解码器组合的场景
#
# 安装步骤：
#   1. cd VideoMergeIOS
#   2. pod install
#   3. 用 Xcode 打开 VideoMerger.xcworkspace（注意是 .xcworkspace 不是 .xcodeproj）
#
# 如果遇到 "Operation not permitted" 错误：
#   - 给 Terminal 授予「完全磁盘访问权限」（系统设置 → 隐私与安全性 → 完全磁盘访问权限）
#   - 或执行：sudo chown -R $(whoami) ~/.cocoapods/repos

platform :ios, '16.0'
use_frameworks!

target 'VideoMerger' do
  # FFmpegKit iOS - full-gpl 变体（含 x264/aac）
  # 直接从 GitHub 加载预编译 podspec，不依赖 cocoapods CDN 仓库。
  # ★ 锁定到具体 commit（96ec894，2025-04-29，podspec 唯一一次提交），
  #   避免上游 main 分支变动导致 pod install / 构建失败。
  #   上游如发布新版本，先人工确认再手动更新此 SHA。
  pod 'ffmpeg-kit-ios-full-gpl',
      :podspec => 'https://raw.githubusercontent.com/xpcapital/ffmpeg-kit-full-gpl/96ec894567e4ba670144cd29178a46997203e6de/ffmpeg-kit-ios-full-gpl.podspec'

  # Google AdMob（开屏 + 首页横幅，海外全球区）
  # UMP 同意 SDK 作为其依赖自动引入；AdSupport.swift 使用 v11+ Swift API
  pod 'GoogleMobileAds', '~> 12.0'

  # Firebase：Crashlytics 崩溃上报 + Analytics 行为统计（海外全球区）
  pod 'FirebaseAnalytics'
  pod 'FirebaseCrashlytics'
end

# 单元测试 target：只继承 search_paths（宿主 App 已链接 ffmpegkit），
# 让测试代码可以 import ffmpegkit 编译通过，而无需重复链接全部动态库
target 'VideoMergerTests' do
  inherit! :search_paths
  pod 'ffmpeg-kit-ios-full-gpl',
      :podspec => 'https://raw.githubusercontent.com/xpcapital/ffmpeg-kit-full-gpl/96ec894567e4ba670144cd29178a46997203e6de/ffmpeg-kit-ios-full-gpl.podspec'
end
